{
  "name": "reporting/backend",
  "description": "Dynamic Reporting System - PHP MVC Backend",
  "type": "project",
  "require": {
    "php": "^8.2",
    "predis/predis": "^2.2",
    "vlucas/phpdotenv": "^5.5",
    "longlang/phpkafka": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
